{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VTTRIG",
  "version": "0.1.2",
  "identifier": "dev.gmveratti.rea-guitar-nam",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VTTRIG | Neural Guitar Studio",
        "width": 1460,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/vttrig-nam-live"
    ],
    "resources": {
      "../engine/THIRD_PARTY_NOTICES.md": "legal/THIRD_PARTY_NOTICES.md",
      "../engine/NAM_CORE_LICENSE.txt": "legal/NeuralAmpModelerCore_LICENSE"
    }
  }
}
