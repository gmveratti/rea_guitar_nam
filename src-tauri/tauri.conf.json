{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VTTRIG",
  "version": "0.1.0",
  "identifier": "dev.gmveratti.rea-guitar-nam",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VTTRIG | Neural Guitar Studio",
        "width": 1460,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ]
  }
}
